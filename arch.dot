digraph architecture {
    graph [
        rankdir=TB
        bgcolor="#0d1117"
        fontname="Helvetica Neue"
        fontcolor="#94a3b8"
        pad=0.6
        splines=ortho
        nodesep=0.7
        ranksep=1.0
        label="Research Dataset Search Engine — Architecture"
        labelloc=t
        fontsize=16
    ]

    node [
        shape=box
        style="rounded,filled"
        fillcolor="#0f1623"
        fontcolor="#e2e8f0"
        fontname="Helvetica Neue"
        fontsize=11
        margin="0.2,0.15"
        penwidth=1.5
    ]

    edge [
        fontname="Helvetica Neue"
        fontsize=9
        fontcolor="#94a3b8"
        penwidth=1.2
    ]

    /* ── PRODUCT LAYER ── */
    subgraph cluster_product {
        label="PRODUCT LAYER"
        fontcolor="#93c5fd"
        fontname="Helvetica Neue Bold"
        fontsize=10
        style="rounded,filled"
        fillcolor="#0d1b2e"
        color="#3b82f6"
        penwidth=1.5
        margin=20

        ui  [label="React UI"     color="#3b82f6"]
        api [label="API Surface"  color="#3b82f6"]
    }

    /* ── DECISION LAYER ── */
    subgraph cluster_logic {
        label="DECISION LAYER"
        fontcolor="#5eead4"
        fontname="Helvetica Neue Bold"
        fontsize=10
        style="rounded,filled"
        fillcolor="#0a1e1b"
        color="#14b8a6"
        penwidth=1.5
        margin=20

        planner [label="Query Planner"    color="#14b8a6"]
        verifier[label="Verifier"         color="#14b8a6"]
        ranking [label="Ranking + Dedupe" color="#14b8a6"]
    }

    /* ── EVIDENCE LAYER ── */
    subgraph cluster_data {
        label="EVIDENCE LAYER"
        fontcolor="#c4b5fd"
        fontname="Helvetica Neue Bold"
        fontsize=10
        style="rounded,filled"
        fillcolor="#110d28"
        color="#7c3aed"
        penwidth=1.5
        margin=20

        discovery [label="Search + Discovery" color="#7c3aed"]
        fetch     [label="Fetch + Parse"      color="#7c3aed"]
        cells     [label="Cell Extraction"    color="#7c3aed"]
    }

    /* ── INFRA LAYER ── */
    subgraph cluster_infra {
        label="INFRA LAYER"
        fontcolor="#86efac"
        fontname="Helvetica Neue Bold"
        fontsize=10
        style="rounded,filled"
        fillcolor="#0a1f12"
        color="#16a34a"
        penwidth=1.5
        margin=20
        rank=same

        providers [label="Gemini / Brave / Tavily" color="#16a34a"]
        kv        [label="KV Cache"                color="#16a34a"]
        d1        [label="D1"                      color="#16a34a"]
        queue     [label="Queue"                   color="#16a34a"]
    }

    /* ── WITHIN-LAYER EDGES ── */
    ui        -> api       [color="#60a5fa"]
    api       -> planner   [color="#60a5fa"]
    api       -> verifier  [color="#60a5fa"]
    verifier  -> ranking   [color="#2dd4bf"]
    planner   -> discovery [color="#2dd4bf"]
    discovery -> fetch     [color="#a78bfa"]
    fetch     -> cells     [color="#a78bfa"]
    verifier  -> cells     [color="#a78bfa"]

    /* ── CROSS-LAYER INFRA EDGES (dimmed) ── */
    api       -> d1        [color="#475569" style=dashed]
    api       -> queue     [color="#475569" style=dashed]
    planner   -> providers [color="#475569" style=dashed]
    discovery -> providers [color="#475569" style=dashed]
    cells     -> providers [color="#475569" style=dashed]
    fetch     -> kv        [color="#475569" style=dashed]
}